# ---- Godot 4+ ----
# 导入缓存与编辑器状态。体积大且完全可由 .tscn / .tres 重建，绝不提交。
.godot/
# Android 构建产物
/android/
# Android 媒体扫描标记，Godot 生成
.nomedia
# 由 CSV 自动生成的翻译资源
*.translation
# Mono/.NET 崩溃转储
mono_crash.*.json

# ---- 导出配置 ----
# 可能内含签名证书路径与密码，默认不提交。
# 如果哪天要复现导出流程，再单独评估要不要放进来。
export_presets.cfg
export_credentials.cfg

# ---- .NET / C# ----
bin/
obj/
*.user
.vs/
.idea/

# ---- 开发期产物 ----
# 截图自检的输出（tools/dev/shot.ps1 生成）
.dev/
# 本地开发工具的会话快照
.dsh/
# DSH 会话自身的临时探针文件，会在 git 操作中途出现/消失。
# 曾经因为一次 `git add -A` 被卷进提交 —— 显式挡住，别再靠"它自己会消失"。
.dsh-hook-probe.json
.dsh-hook-capture.log
.dsh-minimal-probe.txt

# ---- 内部工作文档（不提交）----
# 这两份是给协作会话看的进度/交接记录，不属于项目本身，
# 也不该出现在公开仓库里。文件保留在本地工作区，只是不入库。
docs/HANDOFF.md
docs/STATUS.md

# ---- 第三方插件 ----
# Godot AI MCP 插件整个不入库：它是**开发工具**，不是项目的一部分 ——
# 没有它项目照样跑（游戏代码只依赖 Godot 本身）。7.3 MB / 293 个文件，
# 入库只会让每次 diff 都淹在插件的噪音里。
#
# 文件保留在本地工作区，编辑器与 MCP 工具链照常能用。
# 换机器时按插件的安装说明重新装一份即可。
/addons/godot_ai/
/addons/.godot_ai_update/
